# Настройки админки Beengo. На сервере этот файл лежит в /etc/beengo-admin.env
# (права 600 — ключи никто, кроме root, не прочитает). Значения — без кавычек.

# Вход в админку
ADMIN_USER=admin
ADMIN_PASSWORD=придумайте-длинный-пароль

# Адрес сайта (для ссылок в Telegram)
SITE_URL=https://beengoclient.com

# Помощник ChatGPT и обложки с ИИ (ключ: platform.openai.com → API keys). Можно оставить пустым.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Публикация в Telegram-канал (бот от @BotFather, добавлен в канал администратором). Можно оставить пустым.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@имя_канала

# Технические (обычно не трогать)
PORT=3100
HOST=127.0.0.1
SITE_DIR=/var/www/beengo
